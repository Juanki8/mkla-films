---
interface Props {
  src: string;
  title: string;
  poster?: string;
}

const { src, title, poster } = Astro.props;
---

<video
  class="video-player"
  src={src}
  title={title}
  aria-label={title}
  poster={poster}
  controls
  preload="metadata"
  playsinline
>
  Tu navegador no puede reproducir este video.
</video>

<style>
  .video-player {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #111;
  }
</style>
