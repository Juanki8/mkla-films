---
import type { Project } from "../data/projects";
import VideoPlayer from "./VideoPlayer.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<section class="featured-film section" aria-labelledby="project-title">
  <div class="featured-film-header">
    <a class="back-to-work" href="/#work">← VOLVER A TRABAJOS</a>
  </div>

  <div class="featured-film-image">
    {
      project.video ? (
        <VideoPlayer
          src={project.video}
          title={`${project.title}`}
          poster={project.image}
        />
      ) : (
        <img src={project.image} alt={project.alt} fetchpriority="high" />
      )
    }
  </div>
</section>
